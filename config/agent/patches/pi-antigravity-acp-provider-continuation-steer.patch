+function hasRenderableSteerContent(message: UserMessage): boolean {
+	if (typeof message.content === "string") return message.content.trim().length > 0;
+	return message.content.some(
+		(block) => (block.type === "text" && block.text.trim().length > 0) || block.type === "image",
+	);
+}
+
+/**
+ * Find mid-turn steering / custom messages (converted to `role: "user"` by Pi)
+ * appended after the assistant turn that issued the pending tool/permission calls.
+ */
+export function findContinuationSteerMessages(
+	context: Context,
+	matchedResultIndices: readonly number[],
+): UserMessage[] {
+	if (matchedResultIndices.length === 0) return [];
+	const earliestResultIndex = Math.min(...matchedResultIndices);
+	let assistantIndex = earliestResultIndex;
+	for (let index = earliestResultIndex - 1; index >= 0; index--) {
+		if (context.messages[index]?.role === "assistant") {
+			assistantIndex = index;
+			break;
+		}
+	}
+	const steers: UserMessage[] = [];
+	for (let index = assistantIndex + 1; index < context.messages.length; index++) {
+		const message = context.messages[index];
+		if (message?.role === "user" && hasRenderableSteerContent(message)) {
+			steers.push(message);
+		}
+	}
+	return steers;
+}
+
+const CONTINUATION_STEER_HEADER =
+	"[Pi mid-turn steering message delivered while this tool was running — " +
+	"NOT part of the tool output above; respond to or incorporate this immediately:]";
