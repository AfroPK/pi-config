+				content.push({ type: "text", text: `${CONTINUATION_STEER_HEADER}\n\n${steer.content}` });
+			}
+			continue;
+		}
+		let prependedHeader = false;
+		for (const block of steer.content) {
+			if (block.type === "text") {
+				if (block.text.trim().length === 0) continue;
+				if (!prependedHeader) {
+					content.push({ type: "text", text: `${CONTINUATION_STEER_HEADER}\n\n${block.text}` });
+					prependedHeader = true;
+				} else {
+					content.push({ type: "text", text: block.text });
+				}
+			} else if (block.type === "image") {
+				if (!prependedHeader) {
+					content.push({ type: "text", text: CONTINUATION_STEER_HEADER });
+					prependedHeader = true;
+				}
+				content.push({ type: "image", data: block.data, mimeType: block.mimeType });
+			}
+		}
+	}
 	return {
