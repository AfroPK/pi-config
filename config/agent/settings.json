  ],
  "thinkingBudgets": {
    "minimal": 1024,
    "low": 2048,
    "medium": 4096,
    "high": 16384
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-mcp-adapter\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"npm:pi-skillful\",\"scope\":\"user\"}": "0.5.3"
  },
  "skills": [
    "!**/.agents/skills/**"
  ],
  "hideThinkingBlock": false
