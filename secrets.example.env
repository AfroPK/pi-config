# Copy to .env.local (ignored by git), fill only the services you use, then load
# these names into the environment of the terminal that starts Pi.
# Pi's /login flow is recommended for OpenRouter instead of storing a key here.

OMNIROUTER_API_KEY=
KAGGLE_API_KEY=
KAGGLE_STRATA_API_KEY=
RD_API_KEY=

# Optional: enables the Google backend in extensions/web-search.
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=

# Optional overrides; these are configuration, not secrets.
# PI_COMFY_DIR=D:/AIWorkspace/ComfyUI
# PI_FIRECRAWL_URL=http://192.168.0.117:3002
# PI_VISION_URL=https://openrouter.ai/api/v1/chat/completions
# PI_VISION_MODEL=anthropic/claude-haiku-5.5
